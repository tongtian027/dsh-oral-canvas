{
  "name": "dsh-oral-canvas",
  "version": "0.1.0",
  "description": "口播短视频无限画布：口播稿 → 数字人音频 → SRT 字幕 → 数字人视频 → 代码动效 → 软件实录 → 合成成片",
  "license": "MIT",
  "author": "lenovo",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "oral-video",
    "short-video",
    "canvas",
    "subtitle",
    "ffmpeg"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "assets/icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
